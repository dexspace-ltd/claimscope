{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dexspacehq.com/schemas/claimscope/catalogue-item.json",
  "title": "CatalogueItem",
  "description": "One priceable item in the reinstatement catalogue. Rates are per unit. Schedules pin the catalogue version they were priced with.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "category", "description", "unit", "operation", "material_rate", "labour_minutes", "trade", "sources", "last_reviewed"],
  "properties": {
    "code": { "type": "string", "pattern": "^[A-Z]{2,5}-[0-9]{3}$", "examples": ["FLR-012"] },
    "category": { "type": "string", "examples": ["Vinyl", "Skirting Board", "Emulsion (Walls)", "Protection", "Skips"] },
    "description": { "type": "string", "examples": ["Vinyl sheeting - supply only"] },
    "unit": { "enum": ["M2", "M", "EACH", "NR", "HR", "DAY"] },
    "operation": { "enum": ["supply", "fit", "supply_and_fit", "take_up", "remove_dispose", "remove_set_aside_refit", "apply", "investigate", "prelim"] },
    "default_quantity_basis": { "enum": ["floor_area", "ceiling_area", "wall_area", "perimeter", "count", "hours", "manual"] },
    "per_room": { "type": "boolean", "description": "True for items priced once per room (quantity must be an integer, normally 1)." },
    "material_rate": { "type": "number", "minimum": 0, "description": "GBP per unit, excl. VAT. 0 for labour-only items." },
    "labour_minutes": { "type": "number", "minimum": 0, "description": "Labour time per unit; priced at the trade rate." },
    "trade": { "enum": ["labourer", "decorator", "plasterer", "joiner", "tiler", "floorer", "plumber", "electrician", "drying_specialist", "none"] },
    "pairs_with": { "type": "array", "items": { "type": "string" }, "description": "Codes that normally accompany this item (e.g. take_up -> supply + fit). Used by QA rules." },
    "perils": { "type": "array", "items": { "enum": ["escape_of_water", "flood", "fire", "storm", "impact", "subsidence", "accidental", "malicious"] } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["retailer", "price", "captured_at"],
        "properties": {
          "retailer": { "type": "string", "examples": ["B&Q", "Screwfix", "Wickes", "Toolstation", "manual"] },
          "product_ref": { "type": "string" },
          "url": { "type": "string" },
          "price": { "type": "number" },
          "pack_size": { "type": "string" },
          "captured_at": { "type": "string", "format": "date" }
        }
      }
    },
    "last_reviewed": { "type": "string", "format": "date" }
  }
}
